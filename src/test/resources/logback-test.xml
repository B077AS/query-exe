<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests log to the console only (same colored format as the app), so they never write a logs/ folder into the repo. -->
<configuration>

    <conversionRule conversionWord="customLevel" class="com.queryexe.utils.CustomDebugConfig" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %customLevel(%-5level) %cyan(%logger{30}) - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.queryexe" level="INFO" />

    <root level="WARN">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>

{
  "name": "QueryExe",
  "mainClass": "io.github.b077as.queryexe.Launcher",

  "updateUrl": "https://github.com/B077AS/query-exe/releases/latest/download",
  "policy": "manual",

  "archive": false,

  "appImageName": "QueryExe.AppImage",

  "rawParts": ["app", "launcher"],

  "modules": "java.base,java.compiler,java.instrument,java.logging,java.management,java.naming,java.net.http,java.prefs,java.scripting,java.security.jgss,java.security.sasl,java.sql,java.sql.rowset,java.transaction.xa,java.xml,java.xml.crypto,jdk.charsets,jdk.crypto.ec,jdk.httpserver,jdk.naming.dns,jdk.net,jdk.unsupported",

  "jvmArgs": [
    "--enable-native-access=ALL-UNNAMED"
  ],

  "branding": {
    "icon": "src/main/resources/icon.ico",
    "description": "QueryExe",
    "company": "QueryExe",
    "product": "QueryExe"
  },

  "launcher": {
    "jar": "launcher/target/queryexe-launcher.jar",
    "mainClass": "io.github.b077as.queryexe.launcher.Boot",
    "jvmArgs": [
      "-XX:+UseSerialGC",
      "-Xms8m",
      "-Xmx128m",
      "-XX:TieredStopAtLevel=1",
      "--enable-native-access=ALL-UNNAMED"
    ]
  }
}
